<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Deterministic observability evaluation harness: telemetry-evidence citation, tool-call accuracy, trace correlation, and cardinality/PII safety over JSONL scenarios. No LLM judge or API key required.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data/*.jsonl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
